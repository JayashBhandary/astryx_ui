# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Scape + data inside of this.
/scrape/*

# Local-only notes. RUNBOOK.local.md holds the release, generation and deploy
# procedures, plus the Hosting config below verbatim so it can be restored.
# Keeping the pattern rather than the filename means a second local document
# needs no change here — and none of them reach the published pub archive.
*.local.md

# Firebase. The docs site is deployed from example/build/web, and its Hosting
# configuration is kept out of version control — which also keeps it out of the
# published pub archive. `firebase init hosting` recreates it: site `astryxui`
# in project `svt-b3a6c`. The deploy command is in example/README.md.
# (firebase-debug.log and friends are already covered by `*.log` above.)
.firebase/
.firebaserc
firebase.json
.firebase-cache/


/marketing